{
  "name": "snail-app",
  "version": "1.2.25",
  "description": "Runner for the Snail programming language",
  "author": {
    "name": "Snail Coding Development",
    "email": "noreply@snailcoding.invalid"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "sync:ios": "cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/ios": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "pyodide": "0.27.8"
  },
  "build": {
    "appId": "com.snailcoding.snail",
    "productName": "Snail",
    "files": [
      "electron/**/*",
      "www/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "snail",
        "name": "Snail program",
        "role": "Editor"
      },
      {
        "ext": "cofigsnail",
        "name": "Snail system file",
        "role": "Editor"
      },
      {
        "ext": "configsnail",
        "name": "Snail system file",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Snail Coding Development <noreply@snailcoding.invalid>",
      "synopsis": "Runner for the Snail programming language",
      "mimeTypes": [
        "text/x-snail"
      ]
    }
  }
}
