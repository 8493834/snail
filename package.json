{
  "name": "snail-app",
  "version": "1.1.0",
  "description": "Runner for the Snail programming language",
  "author": "Snail Coding Development",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron ."
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "pyodide": "^0.27.0"
  },
  "build": {
    "appId": "com.snailcoding.snail",
    "productName": "Snail",
    "files": ["electron/**/*", "www/**/*"],
    "fileAssociations": [
      { "ext": "snail", "name": "Snail program" },
      { "ext": "cofigsnail", "name": "Snail system file" },
      { "ext": "configsnail", "name": "Snail system file" }
    ],
    "win": { "target": ["nsis", "portable"] }
  }
}
